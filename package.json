{
  "name": "@namecheap/easy-tunnel",
  "description": "Expose localhost to the world",
  "version": "1.3.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/namecheap/easy-tunnel.git"
  },
  "author": "Namecheap <opensource@namecheap.com>",
  "contributors": [],
  "main": "./easyTunnel.js",
  "types": "./easyTunnel.d.ts",
  "bin": {
    "et": "bin/et.js"
  },
  "scripts": {
    "dev:client": "nodemon --inspect ./bin/et.js --port 8080 --host http://tunnel.rnd.namecheap.net --subdomain test --open",
    "dev:backend": "nodemon server.js",
    "dev": "DEBUG=mytunnel:* concurrently --raw npm:dev:backend npm:dev:client",
    "test": "mocha --timeout 15000 --exit -- *.spec.js",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "1.10.0",
    "debug": "4.4.1",
    "openurl": "1.1.1",
    "pump": "3.0.3",
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "chai": "^4.5.0",
    "chai-string": "^1.6.0",
    "concurrently": "^9.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "mocha": "^11.7.1",
    "nock": "^14.0.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.6",
    "supertest": "^7.1.1"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">= 8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  }
}
